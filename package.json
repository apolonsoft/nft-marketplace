{
  "name": "nft-marketplace",
  "version": "0.0.0",
  "private": true,
  "packageManager": "yarn@4.18.0",
  "engines": {
    "node": ">=24.12.0 <25",
    "yarn": "4.18.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "contracts/*"
  ],
  "scripts": {
    "dev": "turbo run dev --concurrency=100%",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "generate": "turbo run generate",
    "docker": "turbo run docker",
    "affected": "node tooling/scripts/affected.mjs",
    "workspaces:list": "yarn workspaces list"
  },
  "devDependencies": {
    "turbo": "2.10.12"
  }
}
