{
  "name": "nft-marketplace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.18.0",
  "engines": {
    "node": ">=24.12.0 <25",
    "yarn": "4.18.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "contracts/*"
  ],
  "scripts": {
    "dev": "turbo run dev --concurrency=100%",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "yarn format:check && yarn deps:check && turbo run lint",
    "typecheck": "turbo run typecheck",
    "generate": "turbo run generate",
    "generate:check": "node tooling/scripts/check-contract-artifacts.mjs",
    "docker": "turbo run docker",
    "local:up": "node tooling/scripts/local-compose.mjs up",
    "local:down": "node tooling/scripts/local-compose.mjs down",
    "local:logs": "node tooling/scripts/local-compose.mjs logs",
    "local:migrate": "node tooling/scripts/local-compose.mjs migrate",
    "local:seed": "node tooling/scripts/local-compose.mjs seed",
    "local:reset": "node tooling/scripts/local-compose.mjs reset",
    "affected": "node tooling/scripts/affected.mjs",
    "format": "node tooling/scripts/format-check.mjs --write",
    "format:check": "node tooling/scripts/format-check.mjs --check",
    "lint:fix": "turbo run lint:fix",
    "deps:check": "node tooling/scripts/deps-check.mjs",
    "workspaces:list": "yarn workspaces list"
  },
  "devDependencies": {
    "@eslint/js": "npm:^10.0.1",
    "@typescript-eslint/eslint-plugin": "npm:8.69.0",
    "@typescript-eslint/parser": "npm:8.69.0",
    "eslint": "npm:^10.9.1",
    "eslint-plugin-import": "npm:^2.32.0",
    "eslint-plugin-jsx-a11y": "npm:^6.10.2",
    "eslint-plugin-n": "npm:^18.3.0",
    "eslint-plugin-promise": "npm:^7.3.0",
    "eslint-plugin-react": "npm:^7.37.5",
    "eslint-plugin-react-hooks": "npm:^7.1.1",
    "eslint-plugin-security": "npm:^4.0.1",
    "prettier": "npm:^3.9.6",
    "tsx": "^4.19.4",
    "turbo": "2.10.12",
    "typescript": "^5.8.3",
    "typescript-eslint": "npm:^8.69.0",
    "vitest": "^3.2.4"
  }
}
