{
  "name": "nft-marketplace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.18.0",
  "engines": {
    "node": ">=24.12.0 <25",
    "yarn": "4.18.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "contracts/*"
  ],
  "scripts": {
    "dev": "turbo run dev --concurrency=100%",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "yarn format:check && yarn deps:check && turbo run lint",
    "typecheck": "turbo run typecheck",
    "generate": "turbo run generate",
    "docker": "turbo run docker",
    "affected": "node tooling/scripts/affected.mjs",
    "format": "node tooling/scripts/format-check.mjs",
    "format:check": "node tooling/scripts/format-check.mjs",
    "deps:check": "node tooling/scripts/deps-check.mjs",
    "workspaces:list": "yarn workspaces list"
  },
  "devDependencies": {
    "tsx": "^4.19.4",
    "turbo": "2.10.12",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
