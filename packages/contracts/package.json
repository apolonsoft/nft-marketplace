{
  "name": "@nft-marketplace/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./abis/*": { "types": "./dist/abis/*.d.ts", "import": "./dist/abis/*.js" },
    "./addresses": { "types": "./dist/addresses.d.ts", "import": "./dist/addresses.js" },
    "./clients": { "types": "./dist/clients.d.ts", "import": "./dist/clients.js" }
  },
  "scripts": {
    "dev": "yarn generate",
    "build": "../../node_modules/.bin/tsc -p tsconfig.build.json",
    "test": "node scripts/test-generated.mjs",
    "lint": "node scripts/check-generated.mjs",
    "typecheck": "../../node_modules/.bin/tsc -p tsconfig.json --noEmit",
    "generate": "node scripts/generate.mjs",
    "generate:check": "node scripts/check-generated.mjs",
    "docker": "node -e \"console.log('[contracts package] no container is defined')\""
  }
}
