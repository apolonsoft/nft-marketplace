# Select the chain to index: anvil or base-sepolia.
PONDER_NETWORK=anvil

# Local Anvil RPC. Base Sepolia uses BASE_SEPOLIA_RPC_URL instead.
ANVIL_RPC_URL=http://127.0.0.1:8545
BASE_SEPOLIA_RPC_URL=

# Leave DATABASE_URL empty for local PGlite storage.
# Set this to a Postgres connection string for hosted deployments.
DATABASE_URL=
PONDER_DATABASE_DIR=.ponder/pglite

# Optional indexing controls. The default start block is 0.
PONDER_START_BLOCK=0
PONDER_CONFIRMATIONS=

# Contract addresses. These may be supplied directly or loaded from the
# selected deployment manifest in @nft-marketplace/contracts.
FACTORY_ADDRESS=
SETTLEMENT_ADDRESS=
