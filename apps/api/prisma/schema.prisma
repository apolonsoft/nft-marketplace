generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model WalletProfile {
  id             String          @id @default(uuid()) @db.Uuid
  address        String          @unique @db.VarChar(42)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  sessionFamilies SessionFamily[]
  ownedApplications DeveloperApplication[] @relation("ApplicationOwner")
  memberships ApplicationMember[]
  displayNameCiphertext String?
  emailCiphertext String?
  avatarCiphertext String?
  bioCiphertext String?
  privacySettings ProfilePrivacySetting[]
  consentGrants ConsentGrant[]
  privacyAudits PrivacyAudit[]
  transactionIntents TransactionIntent[]
  adminAllowlistEntries AdminWallet[]
  reports UserReport[]
  adminAuditLogs AdminAuditLog[]
}

model SiweNonce {
  id         String    @id @default(uuid()) @db.Uuid
  nonce      String    @unique @db.VarChar(64)
  address    String    @db.VarChar(42)
  domain     String    @db.VarChar(255)
  chainId    Int
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([address, domain, chainId, expiresAt])
}

model SessionFamily {
  id            String         @id @default(uuid()) @db.Uuid
  walletId      String         @db.Uuid
  expiresAt     DateTime
  revokedAt     DateTime?
  revokeReason  String?        @db.VarChar(64)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  wallet        WalletProfile  @relation(fields: [walletId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([walletId, revokedAt])
}

model RefreshToken {
  id                 String        @id @default(uuid()) @db.Uuid
  familyId           String        @db.Uuid
  tokenHash           String        @unique @db.Char(64)
  expiresAt           DateTime
  usedAt              DateTime?
  revokedAt           DateTime?
  replacedByTokenId   String?       @db.Uuid
  createdAt           DateTime      @default(now())
  family              SessionFamily @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([familyId, expiresAt])
}

enum ApplicationStatus {
  ACTIVE
  ARCHIVED
}
enum ApplicationMemberRole {
  OWNER
  ADMIN
  MEMBER
}
enum ApiKeyEnvironment {
  TEST
  LIVE
}

model DeveloperApplication {
  id             String              @id @default(uuid()) @db.Uuid
  ownerWalletId  String              @db.Uuid
  name           String              @db.VarChar(120)
  slug           String              @unique @db.VarChar(80)
  description    String?             @db.VarChar(500)
  status         ApplicationStatus   @default(ACTIVE)
  dailyQuota     Int                 @default(100000)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  owner          WalletProfile       @relation("ApplicationOwner", fields: [ownerWalletId], references: [id])
  members        ApplicationMember[]
  invitations    ApplicationInvitation[]
  apiKeys        ApiKey[]
  usage          ApiUsageDaily[]
  webhookSubscriptions WebhookSubscription[]
  consentGrants  ConsentGrant[]
  privacyAudits  PrivacyAudit[]

  @@index([ownerWalletId, status])
}

model ApplicationMember {
  id            String                @id @default(uuid()) @db.Uuid
  applicationId String                @db.Uuid
  walletId      String                @db.Uuid
  role          ApplicationMemberRole @default(MEMBER)
  invitedAt     DateTime?
  acceptedAt    DateTime              @default(now())
  createdAt     DateTime              @default(now())
  application   DeveloperApplication  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  wallet        WalletProfile         @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@unique([applicationId, walletId])
  @@index([walletId, role])
}

model ApplicationInvitation {
  id            String                @id @default(uuid()) @db.Uuid
  applicationId String                @db.Uuid
  walletAddress String                @db.VarChar(42)
  role          ApplicationMemberRole @default(MEMBER)
  tokenHash     String                @unique @db.Char(64)
  expiresAt     DateTime
  acceptedAt    DateTime?
  revokedAt     DateTime?
  createdAt     DateTime              @default(now())
  application   DeveloperApplication  @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, expiresAt, acceptedAt])
}

model ApiKey {
  id               String            @id @default(uuid()) @db.Uuid
  applicationId    String            @db.Uuid
  environment      ApiKeyEnvironment
  name             String            @db.VarChar(120)
  prefix           String            @db.VarChar(16)
  secretHash       String            @unique @db.Char(64)
  scopes           String[]
  createdAt        DateTime          @default(now())
  lastUsedAt       DateTime?
  rotatedAt        DateTime?
  revokedAt        DateTime?
  replacedByKeyId  String?           @db.Uuid
  application      DeveloperApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, revokedAt])
  @@index([prefix])
}

model ApiUsageDaily {
  id             String              @id @default(uuid()) @db.Uuid
  applicationId  String              @db.Uuid
  keyId          String?             @db.Uuid
  day            DateTime            @db.Date
  endpointGroup  String              @db.VarChar(120)
  statusClass    String              @db.VarChar(3)
  requestCount   Int                 @default(0)
  application    DeveloperApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, keyId, day, endpointGroup, statusClass])
  @@index([applicationId, day])
}

enum ProfileField {
  DISPLAY_NAME
  EMAIL
  AVATAR
  BIO
}
enum ProfileVisibility {
  PRIVATE
  APPLICATION_CONSENTED
  PUBLIC
}
enum ConsentGrantState {
  GRANTED
  REVOKED
}

model ProfilePrivacySetting {
  id          String            @id @default(uuid()) @db.Uuid
  walletId    String            @db.Uuid
  field       ProfileField
  visibility  ProfileVisibility @default(PRIVATE)
  updatedAt   DateTime          @updatedAt
  wallet      WalletProfile     @relation(fields: [walletId], references: [id], onDelete: Cascade)
  @@unique([walletId, field])
}

model ConsentGrant {
  id            String           @id @default(uuid()) @db.Uuid
  walletId      String           @db.Uuid
  applicationId String           @db.Uuid
  field         ProfileField
  purpose       String           @db.VarChar(64)
  state         ConsentGrantState @default(GRANTED)
  policyVersion String           @default("v1") @db.VarChar(32)
  grantedAt     DateTime         @default(now())
  revokedAt     DateTime?
  wallet        WalletProfile   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  application   DeveloperApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  @@unique([walletId, applicationId, field, purpose])
  @@index([applicationId, walletId, state])
}

model PrivacyAudit {
  id            String   @id @default(uuid()) @db.Uuid
  walletId      String   @db.Uuid
  applicationId String?  @db.Uuid
  actorWalletId String?  @db.Uuid
  action        String   @db.VarChar(64)
  field         String?  @db.VarChar(64)
  purpose       String?  @db.VarChar(64)
  result        String   @db.VarChar(32)
  requestId     String?  @db.VarChar(128)
  policyVersion String   @default("v1") @db.VarChar(32)
  metadata      Json?
  createdAt     DateTime @default(now())
  wallet        WalletProfile @relation(fields: [walletId], references: [id], onDelete: Cascade)
  application   DeveloperApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  @@index([walletId, createdAt])
  @@index([applicationId, createdAt])
}

enum IntentOperation {
  DEPLOY_COLLECTION
  MINT
  MINT_BATCH
  APPROVE
  SET_APPROVAL_FOR_ALL
  CREATE_LISTING
  PURCHASE
  CANCEL_LISTING
  WITHDRAW
}
enum IntentStatus {
  CREATED
  SUBMITTED
  CONFIRMED
  FAILED
  EXPIRED
  CONSUMED
}

model TransactionIntent {
  idempotencyKey String        @db.VarChar(128)
  id             String        @id @default(uuid()) @db.Uuid
  walletId       String        @db.Uuid
  operation      IntentOperation
  chainId        Int
  requestHash    String        @db.Char(64)
  to             String        @db.VarChar(42)
  data           String        @db.Text
  value          String        @default("0") @db.VarChar(78)
  gas            String?       @db.VarChar(78)
  status         IntentStatus  @default(CREATED)
  expiresAt      DateTime
  txHash         String?       @db.VarChar(66)
  failureCode    String?       @db.VarChar(64)
  failureDetails Json?
  createdAt      DateTime      @default(now())
  submittedAt    DateTime?
  confirmedAt    DateTime?
  failedAt       DateTime?
  consumedAt     DateTime?
  wallet         WalletProfile @relation(fields: [walletId], references: [id], onDelete: Cascade)
  @@unique([walletId, idempotencyKey])
  @@index([walletId, status, expiresAt])
}

enum AdminWalletStatus {
  ACTIVE
  REVOKED
}
enum ModerationTargetType {
  COLLECTION
  NFT
  LISTING
  PROFILE
}
enum ReportCategory {
  SPAM
  FRAUD
  COPYRIGHT
  HARASSMENT
  OTHER
}
enum ReportStatus {
  OPEN
  RESOLVED
}
enum ModerationStatus {
  VISIBLE
  HIDDEN
  RESOLVED
}

model AdminWallet {
  id String @id @default(uuid()) @db.Uuid
  walletId String @unique @db.Uuid
  status AdminWalletStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  revokedAt DateTime?
  wallet WalletProfile @relation(fields: [walletId], references: [id], onDelete: Cascade)
  @@index([status, createdAt])
}

model ModerationSubject {
  id String @id @default(uuid()) @db.Uuid
  targetType ModerationTargetType
  targetId String @db.VarChar(255)
  status ModerationStatus @default(VISIBLE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  hiddenAt DateTime?
  resolvedAt DateTime?
  @@unique([targetType, targetId])
  @@index([status, targetType, targetId])
}

model UserReport {
  id String @id @default(uuid()) @db.Uuid
  reporterWalletId String @db.Uuid
  targetType ModerationTargetType
  targetId String @db.VarChar(255)
  category ReportCategory
  description String @db.VarChar(2000)
  evidenceUrl String? @db.VarChar(2048)
  status ReportStatus @default(OPEN)
  resolutionReason String? @db.VarChar(1000)
  createdAt DateTime @default(now())
  resolvedAt DateTime?
  reporter WalletProfile @relation(fields: [reporterWalletId], references: [id], onDelete: Cascade)
  @@index([reporterWalletId, createdAt])
  @@index([targetType, targetId, status, createdAt])
}

model AdminAuditLog {
  id String @id @default(uuid()) @db.Uuid
  actorWalletId String @db.Uuid
  action String @db.VarChar(64)
  targetType ModerationTargetType
  targetId String @db.VarChar(255)
  reason String @db.VarChar(1000)
  previousStatus String?
  newStatus String?
  requestId String? @db.VarChar(128)
  metadata Json?
  createdAt DateTime @default(now())
  actor WalletProfile @relation(fields: [actorWalletId], references: [id], onDelete: Restrict)
  @@index([actorWalletId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([action, createdAt])
}

enum WebhookSubscriptionStatus {
  ACTIVE
  DISABLED
}
enum WebhookDeliveryStatus {
  PENDING
  DELIVERED
  RETRYING
  FAILED
  DEAD_LETTER
}

model WebhookSubscription {
  id String @id @default(uuid()) @db.Uuid
  applicationId String @db.Uuid
  endpointUrl String @db.VarChar(2048)
  eventTypes String[]
  secretHash String @db.Char(64)
  secretVersion Int @default(1)
  status WebhookSubscriptionStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastDeliveredAt DateTime?
  application DeveloperApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]
  @@index([applicationId, status])
}

model WebhookDelivery {
  id String @id @default(uuid()) @db.Uuid
  subscriptionId String @db.Uuid
  eventId String @db.VarChar(255)
  eventType String @db.VarChar(64)
  payload Json
  status WebhookDeliveryStatus @default(PENDING)
  attemptCount Int @default(0)
  nextAttemptAt DateTime?
  responseStatus Int?
  errorMessage String? @db.VarChar(1000)
  originalDeliveryId String? @db.Uuid
  createdAt DateTime @default(now())
  deliveredAt DateTime?
  failedAt DateTime?
  subscription WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  deadLetter WebhookDeadLetter?
  @@unique([subscriptionId, eventId])
  @@index([status, nextAttemptAt])
  @@index([subscriptionId, createdAt])
  @@index([eventId])
}

model WebhookDeadLetter {
  id String @id @default(uuid()) @db.Uuid
  deliveryId String @unique @db.Uuid
  reason String @db.VarChar(1000)
  attemptCount Int
  replayedAt DateTime?
  createdAt DateTime @default(now())
  delivery WebhookDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  @@index([createdAt])
}
