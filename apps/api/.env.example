NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://localhost:5432/nft_marketplace
INDEXER_HEALTH_URL=http://127.0.0.1:42069/health
INDEXER_MAX_STALENESS_MS=60000
DEPENDENCY_TIMEOUT_MS=2000
API_DOCS_ENABLED=true
LOG_LEVEL=info
SIWE_ALLOWED_DOMAINS=localhost:3000
SIWE_ALLOWED_CHAIN_IDS=31337
SIWE_STATEMENT=Sign in to NFT Marketplace.
SIWE_NONCE_TTL_SECONDS=600
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_TOKEN_ISSUER=nft-marketplace-api
AUTH_TOKEN_AUDIENCE=nft-marketplace
AUTH_ACCESS_PRIVATE_KEY=
AUTH_ACCESS_PUBLIC_KEY=
AUTH_REFRESH_COOKIE_NAME=nft_refresh
AUTH_SECURE_COOKIES=false
PRIVACY_ENCRYPTION_KEY=development-only-key-change-me
PRIVACY_KEY_VERSION=v1
