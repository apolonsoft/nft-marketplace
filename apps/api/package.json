    "docker": "node -e \"console.log('[api] placeholder: containerization belongs to T-060')\""
  },
  "dependencies": {
    "@apollo/server": "4.12.2",
    "@nestjs/apollo": "13.1.0",
    "@nestjs/common": "11.1.6",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.1.6",
    "@nestjs/graphql": "13.1.0",
    "@nestjs/platform-express": "11.1.6",
    "@nestjs/swagger": "11.2.0",
    "@nft-marketplace/config": "workspace:*",
    "@nft-marketplace/observability": "workspace:*",
    "graphql": "16.11.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "11.1.6",
    "@types/express": "5.0.3",
    "@types/supertest": "6.0.3",
    "esbuild": "0.28.2",
    "supertest": "7.1.4",
    "tsx": "4.20.5",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  }
